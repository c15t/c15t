{
	"name": "@c15t/example-expo-dev",
	"version": "0.0.0",
	"private": true,
	"description": "Expo development-build fixture for @c15t/react-native: the config plugin wires the native consent core, and the screens are the same ones the bare React Native example proves out.",
	"main": "index.ts",
	"scripts": {
		"android": "expo run:android",
		"bundle": "expo export --platform all --output-dir .artifacts/export --clear",
		"check-types": "tsc --noEmit",
		"config": "expo config --type prebuild --json > .artifacts/expo-config.json",
		"fmt": "oxfmt .",
		"ios": "expo run:ios",
		"ios:release": "expo run:ios --configuration Release",
		"lint": "oxlint App.tsx index.ts src app.config.ts metro.config.js",
		"prebuild": "expo prebuild --clean",
		"start": "expo start --dev-client"
	},
	"dependencies": {
		"@c15t/react-native": "workspace:*",
		"expo": "57.0.22",
		"expo-constants": "57.0.18",
		"expo-dev-client": "57.0.19",
		"react": "19.2.7",
		"react-native": "0.86.3"
	},
	"devDependencies": {
		"@babel/runtime": "^7.25.0",
		"@types/node": "25.5.0",
		"@types/react": "~19.2.2",
		"typescript": "7.0.2"
	}
}
