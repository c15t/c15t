# Copy to .env. Never commit the copy: .env is ignored by the repository.
#
# Expo CLI reads this file before it evaluates app.config.ts, so the same values
# reach the config plugin (which writes the native keys) and the screens. Only the
# EXPO_PUBLIC_ prefix survives into the JavaScript bundle, which is the point: those
# strings are visible in the shipped app, so nothing secret may use it.

# Backend for the embedded consent core. The local self-host route in examples/demo
# speaks the hosted wire. For an Android emulator, reach it with:
#   adb reverse tcp:3000 tcp:3000
EXPO_PUBLIC_C15T_BACKEND_URL=http://localhost:3000/api/self-host

# Run the in-JavaScript fake core even when the real module is in the binary.
EXPO_PUBLIC_C15T_FAKE_NATIVE=false

# Period of the fake core's isAllowed sampler, in milliseconds.
EXPO_PUBLIC_C15T_SAMPLE_INTERVAL_MS=1000
