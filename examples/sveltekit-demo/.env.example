# Consent example routes (/consent-example, /manifest-example, /headless-example)
# #region docs:env title=".env"
PUBLIC_C15T_BACKEND_URL=https://your-project.inth.app
PUBLIC_POSTHOG_KEY=
PUBLIC_X_PIXEL_ID=
# #endregion docs:env

# Showcase routes
DATABASE_URL=
REDIS_URL=
REDIS_TOKEN=

# C15T Node SDK Configuration
C15T_API_URL=http://localhost:5173/api/self-host

# Optional dedicated test accounts. Empty values keep SDK requests local.
# Setting an ID enables the vendor's real SDK and can send telemetry.
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
PUBLIC_GOOGLE_TAG_ID=
PUBLIC_CLARITY_ID=

# Local IAB editor testing: no backend writes or saved consent persistence.
# Fetches the vendor list from inth.com; uses the example CMP ID.
PUBLIC_DEVTOOLS_IAB=false
