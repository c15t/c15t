{
	"name": "sveltekit-demo",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"bench:banner-visibility": "bun run ./scripts/run-banner-visibility-bench.ts",
		"bench:script-count": "bun run ./scripts/run-script-count-bench.ts",
		"build": "vite build",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"dev": "vite dev",
		"preview": "vite preview"
	},
	"dependencies": {
		"@c15t/backend": "workspace:*",
		"@c15t/integrations": "workspace:*",
		"@c15t/node-sdk": "workspace:*",
		"@c15t/svelte": "workspace:*",
		"@c15t/translations": "workspace:*",
		"@c15t/ui": "workspace:*",
		"@libsql/kysely-libsql": "^0.4.1",
		"c15t": "workspace:*",
		"kysely": "^0.28.11"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/kit": "3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.0.0",
		"typescript": "6.0.3",
		"vite": "^8.3.1"
	}
}
