# Copy to .env. Never commit the copy: .env is ignored by the repository.
#
# Everything here is build-time only and drives what the JavaScript screens do.
# The native core does not read this file. It reads the keys written into
# ios/Info.plist and android/app/src/main/AndroidManifest.xml, which is what the
# Expo config plugin does for you in examples/expo-dev.

# Backend the screens report. The local self-host route in examples/demo speaks
# the hosted wire. For an Android emulator, reach it with:
#   adb reverse tcp:3000 tcp:3000
C15T_BACKEND_URL=http://localhost:3000/api/self-host

# Run the in-JavaScript fake core even when the real module is in the binary.
# Useful for watching the gating path on a timer without a backend.
C15T_FAKE_NATIVE=false

# Period of the fake core's isAllowed sampler, in milliseconds.
C15T_SAMPLE_INTERVAL_MS=1000
