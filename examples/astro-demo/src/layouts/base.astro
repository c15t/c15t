---
/**
 * Site layout.
 *
 * `<ClientRouter />` is on so navigation happens client-side — the whole
 * point of the demo is that the consent runtime survives that and does not
 * re-initialise per page.
 */
import { ClientRouter } from 'astro:transitions';
import ConsentBanner from '@c15t/astro/components/consent-banner.astro';
import ConsentDialog from '@c15t/astro/components/consent-dialog.astro';
import ConsentDialogTrigger from '@c15t/astro/components/consent-dialog-trigger.astro';
import ConsentScript from '@c15t/astro/components/consent-script.astro';
import IABConsentBanner from '@c15t/astro/components/iab-consent-banner.astro';
import IABConsentDialog from '@c15t/astro/components/iab-consent-dialog.astro';

import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

// One request resolves one policy, so the surfaces follow the model the
// server decided rather than the page. Both pairs render nothing when the
// model is not theirs, so listing both is harmless — it is spelt out here
// because a real site ships the one pair it needs.
const isIAB = Astro.locals.c15t?.snapshot.model === 'iab';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta content="width=device-width, initial-scale=1" name="viewport" />
		<title>{title} — @c15t/astro demo</title>
		<ConsentScript />
		<ClientRouter />
	</head>
	<body>
		<nav>
			<a href="/">Home</a>
			<a href="/second">Second page</a>
			<a href="/geo">Geo overrides</a>
			<a href="/iab">IAB TCF</a>
		</nav>

		<h1>{title}</h1>
		<slot />

		<footer>
			<ConsentDialogTrigger>Cookie preferences</ConsentDialogTrigger>
		</footer>

		{
			isIAB ? (
				<>
					<IABConsentBanner />
					<IABConsentDialog />
				</>
			) : (
				<>
					<ConsentBanner />
					<ConsentDialog />
				</>
			)
		}
	</body>
</html>
