---
import BaseLayout from '../layouts/base.astro';
---

<BaseLayout title="Cookie Policy">
	<p>
		A stand-in for the real cookie policy. The banner's <code
			>legalLinks.cookiePolicy.url</code
		> points here, so the link in the banner and the preference centre resolves
		instead of 404ing.
	</p>

	<section class="panel">
		<h2>What a real policy would say</h2>
		<p>
			Which cookies the site sets, what each category is for, how long they
			last, and how to change the choice later — the preference centre in this
			demo is that control.
		</p>
	</section>
</BaseLayout>
