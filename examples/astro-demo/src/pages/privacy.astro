---
import BaseLayout from '../layouts/base.astro';
---

<BaseLayout title="Privacy Policy">
	<p>
		A stand-in for the real privacy policy. The banner's <code
			>legalLinks.privacyPolicy.url</code
		> points here, so the link in the banner and the preference centre resolves
		instead of 404ing.
	</p>

	<section class="panel">
		<h2>What a real policy would say</h2>
		<p>
			What personal data the site processes, on what lawful basis, who it is
			shared with, and how a visitor exercises their rights.
		</p>
	</section>
</BaseLayout>
