+import { describe, expect, test } from 'vitest';
+import { getDocsMetadataTitle } from './docs-metadata-title';
+
+describe('documentation metadata titles', () => {
+	test.each([
+		[
+			'Quickstart',
+			['frameworks', 'next', 'quickstart'],
+			'Quickstart for Next.js | c15t',
+		],
+		[
+			'Quickstart',
+			['frameworks', 'react', 'quickstart'],
+			'Quickstart for React | c15t',
+		],
+		[
+			'App Router',
+			['frameworks', 'next', 'app-router'],
+			'App Router for Next.js | c15t',
+		],
+		[
+			'Troubleshoot Next.js consent',
+			['frameworks', 'next', 'troubleshooting'],
+			'Troubleshoot Next.js consent | c15t',
+		],
+		['Data fetching', ['guides', 'data-fetching'], 'Data fetching | c15t'],
+		[undefined, [], 'Documentation | c15t'],
+	])('scopes %s at %j', (title, slug, expected) => {
+		expect(getDocsMetadataTitle(title, slug)).toBe(expected);
+	});
+});
