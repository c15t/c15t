diff --git a/packages/docs/src/docs/metadata-title.ts b/packages/docs/src/docs/metadata-title.ts
new file mode 100644
--- /dev/null
+++ b/packages/docs/src/docs/metadata-title.ts
@@ -0,0 +1,71 @@
+const frameworkNames = {
+	next: 'Next.js',
+	'tanstack-start': 'TanStack Start',
+	react: 'React',
+	nuxt: 'Nuxt',
+	vue: 'Vue',
+	astro: 'Astro',
+	svelte: 'Svelte',
+	sveltekit: 'SvelteKit',
+	javascript: 'JavaScript',
+};
+
+const genericTitles = new Set([
+	'overview',
+	'quickstart',
+	'getting started',
+	'installation',
+	'configuration',
+	'reference',
+	'api reference',
+	'introduction',
+]);
+
+function sectionName(segment: string): string {
+	return segment
+		.split('-')
+		.map((word) => {
+			if (['api', 'cli', 'sdk', 'ssr'].includes(word))
+				return word.toUpperCase();
+			return word.charAt(0).toUpperCase() + word.slice(1);
+		})
+		.join(' ');
+}
+
+/** Scope short headings to their framework or section, keeping navigation separate */
+export function getDocsPageTitle(
+	title: string | undefined,
+	slug: string[]
+): string {
+	const pageTitle = title?.trim() || 'Documentation';
+	const frameworkId = slug[0] === 'frameworks' ? slug[1] : undefined;
+	const framework = Object.entries(frameworkNames).find(
+		([id]) => id === frameworkId
+	)?.[1];
+	const parent = slug.at(-2);
+	const context =
+		framework ??
+		(genericTitles.has(pageTitle.toLowerCase()) && parent
+			? sectionName(parent)
+			: undefined);
+	return context && !pageTitle.toLowerCase().includes(context.toLowerCase())
+		? `${pageTitle} for ${context}`
+		: pageTitle;
+}
+
+/** Use one descriptive title for search and social cards without repeating the brand */
+export function getDocsMetadataTitle(
+	title: string | undefined,
+	slug: string[],
+	siteName: string
+): string {
+	const brand = siteName.trim();
+	const suffix = ` | ${brand}`;
+	const unbranded = title?.trim().toLowerCase().endsWith(suffix.toLowerCase())
+		? title.trim().slice(0, -suffix.length)
+		: title;
+	const pageTitle = getDocsPageTitle(unbranded, slug);
+	return !brand || pageTitle.toLowerCase() === brand.toLowerCase()
+		? pageTitle
+		: `${pageTitle}${suffix}`;
+}
diff --git a/packages/docs/src/docs/metadata-title.test.ts b/packages/docs/src/docs/metadata-title.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/docs/src/docs/metadata-title.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from 'vitest';
+import { getDocsMetadataTitle, getDocsPageTitle } from './metadata-title';
+
+describe('documentation titles', () => {
+	it.each([
+		[
+			'c15t',
+			['frameworks', 'next', 'quickstart'],
+			'Quickstart for Next.js | c15t',
+		],
+		[
+			'c15t',
+			['frameworks', 'nuxt', 'quickstart'],
+			'Quickstart for Nuxt | c15t',
+		],
+		['leadtype', ['cli', 'quickstart'], 'Quickstart for CLI | leadtype'],
+		['inrepo', ['quickstart'], 'Quickstart | inrepo'],
+		['DSAR SDK', ['quickstart'], 'Quickstart | DSAR SDK'],
+		['Inth', ['consent', 'quickstart'], 'Quickstart for Consent | Inth'],
+	] as const)(
+		'scopes %s metadata using its page context',
+		(brand, slug, expected) => {
+			expect(getDocsMetadataTitle('Quickstart', [...slug], brand)).toBe(
+				expected
+			);
+		}
+	);
+
+	it('keeps branding out of the heading', () => {
+		expect(
+			getDocsPageTitle('ConsentBanner', [
+				'frameworks',
+				'react',
+				'components',
+				'consent-banner',
+			])
+		).toBe('ConsentBanner for React');
+	});
+
+	it('preserves descriptive titles without repeating framework or brand', () => {
+		expect(
+			getDocsMetadataTitle(
+				'Next.js consent setup | c15t',
+				['frameworks', 'next', 'quickstart'],
+				'c15t'
+			)
+		).toBe('Next.js consent setup | c15t');
+		expect(
+			getDocsMetadataTitle(
+				'Configure your backend',
+				['guides', 'backend'],
+				'Inth'
+			)
+		).toBe('Configure your backend | Inth');
+	});
+
+	it('provides a meaningful fallback for missing and blank titles', () => {
+		expect(getDocsMetadataTitle(undefined, [], 'leadtype')).toBe(
+			'Documentation | leadtype'
+		);
+		expect(getDocsMetadataTitle('  ', [], 'Inth')).toBe('Documentation | Inth');
+	});
+});
