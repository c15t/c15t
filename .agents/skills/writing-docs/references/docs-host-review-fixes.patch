@@ -0,0 +1,10 @@
+import { getDocsMetadataTitle as createTitle } from '@inth/optin-docs/docs/metadata-title';
+
+/** Compose c15t titles while preserving the existing helper API */
+export function getDocsMetadataTitle(
+	title: string | undefined,
+	slug: string[],
+	siteName = 'c15t'
+): string {
+	return createTitle(title, slug, siteName);
+}
