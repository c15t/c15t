diff --git a/packages/docs/src/docs/frameworks.test.ts b/packages/docs/src/docs/frameworks.test.ts
new file mode 100644
index 0000000000..e9a9ee4d00
--- /dev/null
+++ b/packages/docs/src/docs/frameworks.test.ts
@@ -0,0 +1,41 @@
+import { describe, expect, it } from 'vitest';
+import {
+	getDefaultFrameworkOptions,
+	getCurrentFrameworkFromSlug,
+	getFramework,
+	getFrameworkUrl,
+} from './frameworks';
+
+describe('v3 framework navigation', () => {
+	it('orders the switcher by framework family', () => {
+		expect(getDefaultFrameworkOptions().map((option) => option.title)).toEqual([
+			'Next.js',
+			'TanStack Start',
+			'React',
+			'Nuxt',
+			'Vue',
+			'Astro',
+			'Svelte',
+			'SvelteKit',
+			'JavaScript',
+		]);
+	});
+
+	it.each([
+		'next',
+		'react',
+		'vue',
+		'nuxt',
+		'svelte',
+		'sveltekit',
+		'astro',
+		'tanstack-start',
+		'javascript',
+	])('recognizes %s pages and their quickstart destination', (id) => {
+		expect(getFramework(id)?.id).toBe(id);
+		expect(getCurrentFrameworkFromSlug(['frameworks', id, 'quickstart'])).toBe(
+			id
+		);
+		expect(getFrameworkUrl(id)).toBe(`/docs/frameworks/${id}/quickstart`);
+	});
+});
