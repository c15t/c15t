{
	"name": "@c15t/core",
	"version": "2.2.0-canary-20260731105620",
	"description": "Headless JavaScript consent management platform for cookie banners, privacy preferences, consent storage, and script gating.",
	"keywords": [
		"consent",
		"privacy",
		"gdpr",
		"ccpa",
		"lgpd",
		"tcf",
		"iab",
		"cmp",
		"consent-management",
		"consent-management-platform",
		"cookie-banner",
		"cookie-consent",
		"cookies",
		"consent-banner",
		"consent-manager",
		"preference-center",
		"headless",
		"javascript",
		"typescript",
		"ssr",
		"server-side-rendering",
		"tracking-consent",
		"eu-cookie-law",
		"google-consent-mode",
		"consent-mode-v2",
		"self-hosted-cmp"
	],
	"homepage": "https://c15t.com/docs/frameworks/javascript/quickstart",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/core"
	},
	"license": "Apache-2.0",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./v3": {
			"types": "./dist-types/v3/index.d.ts",
			"import": "./dist/v3.js",
			"require": "./dist/v3.cjs"
		},
		"./v3/consent-record": {
			"types": "./dist-types/v3/consent-record/index.d.ts",
			"import": "./dist/v3-consent-record.js",
			"require": "./dist/v3-consent-record.cjs"
		},
		"./v3/transports": {
			"types": "./dist-types/v3/transports/index.d.ts",
			"import": "./dist/v3-transports.js",
			"require": "./dist/v3-transports.cjs"
		},
		"./v3/libs/generate-subject-id": {
			"types": "./dist-types/v3/libs/generate-subject-id.d.ts",
			"import": "./dist/v3-generate-subject-id.js",
			"require": "./dist/v3-generate-subject-id.cjs"
		},
		"./v3/modules/script-loader": {
			"types": "./dist-types/v3/modules/script-loader/index.d.ts",
			"import": "./dist/v3-script-loader.js",
			"require": "./dist/v3-script-loader.cjs"
		},
		"./v3/modules/network-blocker": {
			"types": "./dist-types/v3/modules/network-blocker/index.d.ts",
			"import": "./dist/v3-network-blocker.js",
			"require": "./dist/v3-network-blocker.cjs"
		},
		"./v3/modules/iframe-blocker": {
			"types": "./dist-types/v3/modules/iframe-blocker/index.d.ts",
			"import": "./dist/v3-iframe-blocker.js",
			"require": "./dist/v3-iframe-blocker.cjs"
		},
		"./v3/modules/persistence": {
			"types": "./dist-types/v3/modules/persistence/index.d.ts",
			"import": "./dist/v3-persistence.js",
			"require": "./dist/v3-persistence.cjs"
		},
		"./v3/modules/window-debug": {
			"types": "./dist-types/v3/modules/window-debug/index.d.ts",
			"import": "./dist/v3-window-debug.js",
			"require": "./dist/v3-window-debug.cjs"
		}
	},
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "./dist-types/index.d.ts",
	"files": [
		"dist",
		"dist-types",
		"AGENTS.md",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"prebuild": "genversion --esm --semi src/version.ts",
		"build": "bun prebuild && rslib build && bun ../../scripts/normalize-dist-types.mjs && bun ../../scripts/generate-package-docs.ts @c15t/core",
		"build:docs": "bun ../../scripts/generate-package-docs.ts @c15t/core",
		"check-types": "bun prebuild && tsc --noEmit",
		"check-types:test": "tsc -p tsconfig.test.json",
		"dev": "sh -c 'bun prebuild && rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun biome format --write . && bun biome check --formatter-enabled=false --linter-enabled=false --write",
		"lint": "bun biome lint ./src",
		"prepack": "bun ../../scripts/verify-package-artifacts.ts",
		"test": "bun prebuild && vitest run",
		"test:watch": "bun prebuild && vitest"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
	],
	"dependencies": {
		"@c15t/schema": "workspace:*",
		"@c15t/translations": "workspace:*",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"genversion": "3.2.0",
		"typescript": "7.0.2",
		"vitest-localstorage-mock": "0.1.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
