		"ccpa",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management",
		"consent-management-platform",
		"consent-manager",
		"consent-mode-v2",
		"cookie-banner",
		"cookie-consent",
		"cookies",
		"eu-cookie-law",
		"gdpr",
		"google-consent-mode",
		"headless",
		"iab",
		"javascript",
		"lgpd",
		"preference-center",
		"privacy",
		"self-hosted-cmp",
		"server-side-rendering",
		"ssr",
		"tcf",
		"tracking-consent",
		"typescript"
	],
	"homepage": "https://c15t.com/docs/frameworks/javascript/quickstart",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/core"
	},
