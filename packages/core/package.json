{
	"name": "@c15t/core",
	"version": "2.2.0-canary-20260731105620",
	"description": "Headless JavaScript consent management platform for cookie banners, privacy preferences, consent storage, and script gating.",
	"keywords": [
		"ccpa",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management",
		"consent-management-platform",
		"consent-manager",
		"consent-mode-v2",
		"cookie-banner",
		"cookie-consent",
		"cookies",
		"eu-cookie-law",
		"gdpr",
		"google-consent-mode",
		"headless",
		"iab",
		"javascript",
		"lgpd",
		"preference-center",
		"privacy",
		"self-hosted-cmp",
		"server-side-rendering",
		"ssr",
		"tcf",
		"tracking-consent",
		"typescript"
	],
	"homepage": "https://c15t.com/docs/frameworks/javascript/quickstart",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/core"
	},
	"files": [
		"dist",
		"dist-types",
		"AGENTS.md",
		"docs",
		"README.md",
		"CHANGELOG.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./consent-record": {
			"types": "./dist-types/consent-record/index.d.ts",
			"import": "./dist/consent-record.js",
			"default": "./dist/consent-record.js"
		},
		"./transports": {
			"types": "./dist-types/transports/index.d.ts",
			"import": "./dist/transports.js",
			"default": "./dist/transports.js"
		},
		"./transports/manifest": {
			"types": "./dist-types/transports/manifest.d.ts",
			"import": "./dist/transport-manifest.js",
			"default": "./dist/transport-manifest.js"
		},
		"./transports/manifest-cache": {
			"types": "./dist-types/transports/manifest-cache.d.ts",
			"import": "./dist/transport-manifest-cache.js",
			"default": "./dist/transport-manifest-cache.js"
		},
		"./libs/generate-subject-id": {
			"types": "./dist-types/libs/generate-subject-id.d.ts",
			"import": "./dist/generate-subject-id.js",
			"default": "./dist/generate-subject-id.js"
		},
		"./modules/script-loader": {
			"types": "./dist-types/modules/script-loader/index.d.ts",
			"import": "./dist/script-loader.js",
			"default": "./dist/script-loader.js"
		},
		"./modules/network-blocker": {
			"types": "./dist-types/modules/network-blocker/index.d.ts",
			"import": "./dist/network-blocker.js",
			"default": "./dist/network-blocker.js"
		},
		"./modules/iframe-blocker": {
			"types": "./dist-types/modules/iframe-blocker/index.d.ts",
			"import": "./dist/iframe-blocker.js",
			"default": "./dist/iframe-blocker.js"
		},
		"./modules/persistence": {
			"types": "./dist-types/modules/persistence/index.d.ts",
			"import": "./dist/persistence.js",
			"default": "./dist/persistence.js"
		},
		"./modules/window-debug": {
			"types": "./dist-types/modules/window-debug/index.d.ts",
			"import": "./dist/window-debug.js",
			"default": "./dist/window-debug.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun prebuild && rslib build && bun ../../scripts/normalize-dist-types.mjs && bun ../../scripts/generate-package-docs.ts @c15t/core",
		"build:docs": "bun ../../scripts/generate-package-docs.ts @c15t/core",
		"check-types": "bun prebuild && tsc --noEmit",
		"check-types:test": "tsc -p tsconfig.test.json",
		"dev": "sh -c 'bun prebuild && rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun oxfmt .",
		"lint": "bun oxlint ./src",
		"prebuild": "genversion --esm --semi src/version.ts",
		"prepack": "bun ../../scripts/verify-package-artifacts.ts",
		"test": "bun prebuild && vitest run",
		"test:watch": "bun prebuild && vitest"
	},
	"dependencies": {
		"@c15t/schema": "workspace:*",
		"@c15t/translations": "workspace:*",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"genversion": "3.2.0",
		"typescript": "7.0.2",
		"vitest-localstorage-mock": "0.1.2"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
	]
}
