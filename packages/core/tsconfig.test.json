{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"rootDir": "../..",
		"noImplicitAny": false,
		"strictNullChecks": true,
		"noEmit": true
	},
	"include": [
		"src/**/__tests__/**/*.ts",
		"src/**/*.test.ts",
		"src/**/*.spec.ts",
		"src/**/*.browser.test.ts"
	],
	"exclude": ["node_modules"]
}
