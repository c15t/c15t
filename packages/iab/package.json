{
	"name": "@c15t/iab",
	"version": "2.2.0-canary-20260731105620",
	"description": "IAB TCF 2.3 addon for c15t with TC String generation, GVL support, and programmatic advertising consent.",
	"keywords": [
		"iab",
		"tcf",
		"consent",
		"privacy",
		"gdpr",
		"cmp",
		"iab-tcf-2.3",
		"tc-string",
		"global-vendor-list",
		"programmatic-advertising",
		"transparency-consent-framework"
	],
	"homepage": "https://c15t.com/docs/frameworks/react/iab/overview",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/iab"
	},
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./headless": {
			"types": "./dist-types/headless.d.ts",
			"import": "./dist/headless.js",
			"default": "./dist/headless.js"
		},
		"./v3": {
			"types": "./dist-types/v3/index.d.ts",
			"import": "./dist/v3.js",
			"default": "./dist/v3.js"
		},
		"./v3/headless": {
			"types": "./dist-types/v3/headless.d.ts",
			"import": "./dist/v3/headless.js",
			"default": "./dist/v3/headless.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"files": [
		"dist",
		"dist-types"
	],
	"scripts": {
		"prebuild": "genversion --esm --semi src/version.ts",
		"build": "bun prebuild && rslib build && bun ../../scripts/normalize-dist-types.mjs",
		"check-types": "tsc --noEmit",
		"dev": "sh -c 'bun prebuild && rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun oxfmt .",
		"lint": "bun oxlint ./src",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@c15t/core": "workspace:*",
		"@c15t/schema": "workspace:*",
		"@iabtechlabtcf/core": "^1.5.21"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"genversion": "3.2.0",
		"typescript": "7.0.2"
	},
	"publishConfig": {
		"access": "public"
	}
}
