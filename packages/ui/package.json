{
	"name": "@c15t/ui",
	"version": "2.2.0-canary-20260731105620",
	"description": "Framework-agnostic primitives, CSS, and theme system powering c15t consent UIs (React, Solid, Svelte, Vue).",
	"keywords": [
		"c15t",
		"cmp",
		"consent",
		"cookie-banner",
		"design-system",
		"framework-agnostic",
		"headless-ui",
		"primitives",
		"privacy",
		"react",
		"tailwind",
		"ui"
	],
	"homepage": "https://c15t.com",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t"
	},
	"files": [
		"dist",
		"dist-types",
		"styles.css",
		"styles.tw3.css",
		"iab",
		"src/primitives",
		"src/styles",
		"!src/styles/**/__tests__/**",
		"!src/styles/**/*.test.ts",
		"types"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"exports": {
		"./styles.css": "./dist/styles.css",
		"./styles.tw3.css": "./dist/styles.tw3.css",
		"./iab/styles.css": "./dist/iab/styles.css",
		"./iab/styles.tw3.css": "./dist/iab/styles.tw3.css",
		"./postcss-tailwind3": {
			"types": "./dist-types/postcss-tailwind3.d.ts",
			"import": "./dist/postcss-tailwind3.js",
			"default": "./dist/postcss-tailwind3.js"
		},
		"./primitives": {
			"types": "./dist-types/primitives/index.d.ts",
			"import": "./dist/primitives/index.js",
			"default": "./dist/primitives/index.js"
		},
		"./primitives/data-state": {
			"types": "./dist-types/primitives/data-state.d.ts",
			"import": "./dist/primitives/data-state.js",
			"default": "./dist/primitives/data-state.js"
		},
		"./primitives/*": {
			"types": "./dist-types/primitives/*/index.d.ts",
			"import": "./dist/primitives/*/index.js",
			"default": "./dist/primitives/*/index.js"
		},
		"./theme": {
			"types": "./dist-types/theme/index.d.ts",
			"import": "./dist/theme/index.js",
			"default": "./dist/theme/index.js"
		},
		"./utils": {
			"types": "./dist-types/utils/index.d.ts",
			"import": "./dist/utils/index.js",
			"default": "./dist/utils/index.js"
		},
		"./styles/primitives": {
			"types": "./dist-types/styles/primitives/index.d.ts",
			"import": "./dist/styles/primitives/index.js",
			"default": "./dist/styles/primitives/index.js"
		},
		"./styles/primitives/*": {
			"types": "./dist-types/styles/primitives/*.d.ts",
			"import": "./dist/styles/primitives/*.js",
			"default": "./dist/styles/primitives/*.js"
		},
		"./styles/primitives/*.module.js": {
			"types": "./src/styles/css-module.d.ts",
			"import": "./dist/styles/primitives/*.module.js",
			"default": "./dist/styles/primitives/*.module.js"
		},
		"./styles/primitives/*.module.css": {
			"types": "./src/styles/css-module.d.ts",
			"import": "./dist/styles/primitives/*.module.js",
			"default": "./dist/styles/primitives/*.module.js"
		},
		"./utils/*": {
			"types": "./dist-types/utils/*.d.ts",
			"import": "./dist/utils/*.js",
			"default": "./dist/utils/*.js"
		},
		"./styles/*.module.js": {
			"types": "./src/styles/css-module.d.ts",
			"import": "./dist/styles/*.module.js",
			"default": "./dist/styles/*.module.js"
		},
		"./styles/*.module.css": "./dist/styles/*.module.css",
		"./styles/*": "./dist/styles/*",
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles/components/*.css": "./dist/styles/components/*.css",
		"./styles/components/*": {
			"types": "./dist/styles/components/*.d.ts",
			"style": "./dist/styles/components/*.css",
			"node": "./dist/styles/components/*.node.js",
			"import": "./dist/styles/components/*.js",
			"default": "./dist/styles/components/*.js"
		},
		"./styles/components/*.module.css": {
			"types": "./dist/styles/components/*.d.ts",
			"style": "./dist/styles/components/*.css",
			"node": "./dist/styles/components/*.node.js",
			"import": "./dist/styles/components/*.js",
			"default": "./dist/styles/components/*.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rslib build && bun ../../scripts/normalize-dist-types.mjs && tcm src/styles/components -p \"*.module.css\" -o types/styles/components --camelCase && bun scripts/generate-style-artifacts.ts && bun scripts/generate-css-entrypoints.ts",
		"dev": "sh -c 'rslib build --no-dts --no-clean && tcm src/styles/components -p \"*.module.css\" -o types/styles/components --camelCase && bun scripts/generate-style-artifacts.ts && bun scripts/generate-css-entrypoints.ts && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun oxfmt .",
		"lint": "bun oxlint ./src",
		"test": "vitest run"
	},
	"dependencies": {
		"@c15t/core": "workspace:*",
		"@c15t/translations": "workspace:*"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@rslib/core": "0.23.2",
		"postcss": "8.5.10",
		"typed-css-modules": "0.9.1",
		"typescript": "7.0.2",
		"vitest": "4.1.9"
	}
}
