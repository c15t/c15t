{
	"name": "@c15t/node-sdk",
	"version": "3.0.0-alpha.6",
	"description": "Typed client for the c15t consent API: check consent, link users, record consents and publish legal documents from server code.",
	"keywords": [
		"c15t",
		"ccpa",
		"cmp",
		"consent",
		"consent-api",
		"consent-management",
		"consent-records",
		"gdpr",
		"lgpd",
		"node",
		"nodejs",
		"privacy",
		"sdk",
		"self-hosted-cmp",
		"server-side",
		"typescript"
	],
	"homepage": "https://c15t.com",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/node-sdk"
	},
	"files": [
		"dist",
		"dist-types"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist-types/testing.d.ts",
			"import": "./dist/testing.js",
			"default": "./dist/testing.js"
		}
	},
	"scripts": {
		"build": "bun prebuild && rslib build && bun ../../scripts/normalize-dist-types.mjs",
		"check-types": "bun prebuild && tsc --noEmit && tsc -p tsconfig.type-tests.json",
		"check-types:test": "bun prebuild && tsc -p tsconfig.test.json",
		"dev": "sh -c 'bun prebuild && rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun oxfmt .",
		"lint": "bun oxlint ./src",
		"prebuild": "genversion --esm --semi src/version.ts",
		"test": "bun prebuild && vitest run",
		"test:watch": "bun prebuild && vitest"
	},
	"dependencies": {
		"@c15t/schema": "workspace:*"
	},
	"devDependencies": {
		"@c15t/backend": "workspace:*",
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@types/node": "25.5.0",
		"genversion": "3.2.0",
		"typescript": "7.0.2"
	}
}
