{
	"name": "@c15t/utils",
	"version": "2.0.0",
	"description": "Shared utilities for c15t packages",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t",
		"directory": "packages/utils"
	},
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src"
	],
	"scripts": {
		"build": "tsc --noEmit",
		"check-types": "tsc --noEmit",
		"fmt": "bun biome format --write .",
		"lint": "bun biome lint ./src",
		"test": "vitest run"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"typescript": "5.9.3",
		"vitest": "4.0.15"
	},
	"publishConfig": {
		"access": "public"
	}
}
