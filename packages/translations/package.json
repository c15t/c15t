		"c15t",
		"ccpa",
		"cmp",
		"consent",
		"cookie-banner",
		"gdpr",
		"i18n",
		"localization",
		"privacy",
		"translations",
		"typescript"
	],
	"homepage": "https://c15t.com/docs/customization/translations",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/translations"
	},
	"files": [
		"dist",
		"dist-types"
	],
	"type": "module",
	"sideEffects": [
		"./dist/all.js",
		"./dist/languages/*.js"
	],
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
