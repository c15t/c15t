	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rslib build && bun ../../scripts/normalize-dist-types.mjs",
		"check-types": "tsc --noEmit",
		"dev": "sh -c 'rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun oxfmt .",
		"generate:i18n": "lingo.dev i18n",
		"lint": "bun oxlint ./src",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"lingo.dev": "^0.137.8",
		"typescript": "7.0.2"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
