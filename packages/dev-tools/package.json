{
	"name": "@c15t/dev-tools",
	"version": "2.2.0-canary-20260731105620",
	"description": "Kernel-first developer tools for inspecting and debugging c15t consent state.",
	"keywords": [
		"c15t",
		"cmp",
		"consent",
		"debugging",
		"developer-tools",
		"devtools",
		"gdpr",
		"privacy"
	],
	"homepage": "https://c15t.com",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/dev-tools"
	},
	"files": [
		"dist",
		"dist-types"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "bun prebuild && rslib build && bun ../../scripts/normalize-dist-types.mjs",
		"check-types": "bun prebuild && tsc --noEmit",
		"dev": "sh -c 'bun prebuild && rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun oxfmt .",
		"lint": "bun oxlint ./src",
		"prebuild": "genversion --esm --semi src/version.ts",
		"test": "bun prebuild && vitest run"
	},
	"dependencies": {
		"@c15t/core": "workspace:*"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"genversion": "3.2.0",
		"jsdom": "^25.0.0",
		"postcss": "^8.5.16",
		"typescript": "7.0.2",
		"vitest": "4.1.9"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
	]
}
