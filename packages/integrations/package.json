		"sentry-browser-v10-min": "npm:@sentry/browser@10.67.0",
		"sentry-browser-v11": "npm:@sentry/browser@^11.0.0",
		"sentry-browser-v11-min": "npm:@sentry/browser@11.0.0",
		"typescript": "7.0.2"
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
	]
