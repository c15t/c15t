{
	"name": "@c15t/vue",
	"version": "3.0.0-alpha.0",
	"description": "Developer-first CMP for Vue and Nuxt: cookie banner, consent manager, preference center composables. GDPR ready with minimal setup and rich customization",
	"keywords": [
		"ccpa",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management-platform",
		"cookie-banner",
		"gdpr",
		"headless",
		"lgpd",
		"nuxt",
		"privacy",
		"privacy-compliance",
		"typescript",
		"user-consent",
		"vue",
		"web-privacy"
	],
	"homepage": "https://c15t.com",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/vue"
	},
	"files": [
		"dist",
		"schema",
		"docs",
		"AGENTS.md",
		"SKILL.md"
	],
	"type": "module",
	"main": "./dist/module.mjs",
	"types": "./dist/module.d.mts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/module.d.mts"
			],
			"vite": [
				"./dist/vite.d.mts"
			],
			"vue-plugin": [
				"./dist/index.d.mts"
			],
			"devtools": [
				"./dist/devtools.d.mts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/module.d.mts",
			"import": "./dist/module.mjs",
			"default": "./dist/module.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"import": "./dist/vite.mjs",
			"default": "./dist/vite.mjs"
		},
		"./vue-plugin": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./devtools": {
			"types": "./dist/devtools.d.mts",
			"import": "./dist/devtools.mjs",
			"default": "./dist/devtools.mjs"
		},
		"./consent-root": {
			"types": "./dist/runtime/components/root.d.vue.ts",
			"import": "./dist/runtime/components/root.vue",
			"default": "./dist/runtime/components/root.vue"
		},
		"./consent-widget": {
			"types": "./dist/runtime/components/preferences.d.vue.ts",
			"import": "./dist/runtime/components/preferences.vue",
			"default": "./dist/runtime/components/preferences.vue"
		},
		"./runtime/*": "./dist/runtime/*",
		"./composables/*": "./dist/runtime/composables/*",
		"./runtime/components/consent-banner.vue": {
			"types": "./dist/runtime/components/prompt.d.vue.ts",
			"import": "./dist/runtime/components/prompt.vue",
			"default": "./dist/runtime/components/prompt.vue"
		},
		"./runtime/components/consent-dialog-trigger.vue": {
			"types": "./dist/runtime/components/panel-trigger.d.vue.ts",
			"import": "./dist/runtime/components/panel-trigger.vue",
			"default": "./dist/runtime/components/panel-trigger.vue"
		},
		"./runtime/components/consent-manager.vue": {
			"types": "./dist/runtime/components/manager.d.vue.ts",
			"import": "./dist/runtime/components/manager.vue",
			"default": "./dist/runtime/components/manager.vue"
		},
		"./runtime/components/consent-widget-manager-context.js": {
			"types": "./dist/runtime/components/preferences-manager-context.d.ts",
			"import": "./dist/runtime/components/preferences-manager-context.js",
			"default": "./dist/runtime/components/preferences-manager-context.js"
		},
		"./runtime/components/consent-widget.vue": {
			"types": "./dist/runtime/components/preferences.d.vue.ts",
			"import": "./dist/runtime/components/preferences.vue",
			"default": "./dist/runtime/components/preferences.vue"
		},
		"./runtime/components/iab-consent-banner.vue": {
			"types": "./dist/runtime/components/iab-prompt.d.vue.ts",
			"import": "./dist/runtime/components/iab-prompt.vue",
			"default": "./dist/runtime/components/iab-prompt.vue"
		},
		"./runtime/components/iab-consent-dialog.vue": {
			"types": "./dist/runtime/components/iab-panel.d.vue.ts",
			"import": "./dist/runtime/components/iab-panel.vue",
			"default": "./dist/runtime/components/iab-panel.vue"
		},
		"./runtime/components/consent-branding-icon.vue": {
			"types": "./dist/runtime/components/branding-icon.d.vue.ts",
			"import": "./dist/runtime/components/branding-icon.vue",
			"default": "./dist/runtime/components/branding-icon.vue"
		},
		"./runtime/components/consent-preferences-link.vue": {
			"types": "./dist/runtime/components/preferences-link.d.vue.ts",
			"import": "./dist/runtime/components/preferences-link.vue",
			"default": "./dist/runtime/components/preferences-link.vue"
		},
		"./runtime/components/consent-button.vue": {
			"types": "./dist/runtime/components/button.d.vue.ts",
			"import": "./dist/runtime/components/button.vue",
			"default": "./dist/runtime/components/button.vue"
		},
		"./runtime/components/consent-tag.vue": {
			"types": "./dist/runtime/components/tag.d.vue.ts",
			"import": "./dist/runtime/components/tag.vue",
			"default": "./dist/runtime/components/tag.vue"
		},
		"./runtime/components/consent-actions.vue": {
			"types": "./dist/runtime/components/actions.d.vue.ts",
			"import": "./dist/runtime/components/actions.vue",
			"default": "./dist/runtime/components/actions.vue"
		},
		"./runtime/components/consent-switch.vue": {
			"types": "./dist/runtime/components/switch.d.vue.ts",
			"import": "./dist/runtime/components/switch.vue",
			"default": "./dist/runtime/components/switch.vue"
		},
		"./runtime/components/consent-link.vue": {
			"types": "./dist/runtime/components/link.d.vue.ts",
			"import": "./dist/runtime/components/link.vue",
			"default": "./dist/runtime/components/link.vue"
		},
		"./runtime/components/consent-description.vue": {
			"types": "./dist/runtime/components/description.d.vue.ts",
			"import": "./dist/runtime/components/description.vue",
			"default": "./dist/runtime/components/description.vue"
		},
		"./runtime/components/consent-frame.vue": {
			"types": "./dist/runtime/components/frame.d.vue.ts",
			"import": "./dist/runtime/components/frame.vue",
			"default": "./dist/runtime/components/frame.vue"
		},
		"./runtime/components/consent-legal-links.vue": {
			"types": "./dist/runtime/components/legal-links.d.vue.ts",
			"import": "./dist/runtime/components/legal-links.vue",
			"default": "./dist/runtime/components/legal-links.vue"
		},
		"./runtime/components/consent-root.vue": {
			"types": "./dist/runtime/components/root.d.vue.ts",
			"import": "./dist/runtime/components/root.vue",
			"default": "./dist/runtime/components/root.vue"
		},
		"./runtime/components/nuxt-consent-root.vue": {
			"types": "./dist/runtime/components/nuxt-root.d.vue.ts",
			"import": "./dist/runtime/components/nuxt-root.vue",
			"default": "./dist/runtime/components/nuxt-root.vue"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "nuxt-module-build build",
		"build:docs": "bun ../../scripts/generate-package-docs.ts @c15t/vue",
		"check-types": "bun run check-types:nuxt && bun run check-types:vue",
		"check-types:nuxt": "nuxt typecheck playground",
		"check-types:vue": "vue-tsc -p tsconfig.vue.json --noEmit",
		"dev": "nuxt dev playground",
		"dev:build": "nuxt build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
		"prepack": "bun run build:docs && bun run build",
		"test": "vitest run"
	},
	"dependencies": {
		"@c15t/core": "workspace:*",
		"@c15t/dev-tools": "workspace:*",
		"@c15t/iab": "workspace:*",
		"@c15t/schema": "workspace:*",
		"@c15t/translations": "workspace:*",
		"@c15t/ui": "workspace:*",
		"@nuxt/kit": "^3.0.0 || ^4.0.0",
		"defu": "^6.1.4",
		"ufo": "^1.6.1"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@nuxt/module-builder": "^1.0.2",
		"@vitejs/plugin-vue": "6.0.7",
		"@vue/test-utils": "^2.4.6",
		"h3": "1.15.11",
		"jsdom": "^25.0.0",
		"nitropack": "2.13.4",
		"nuxt": "^4.5.1",
		"pathe": "^2.0.3",
		"typescript": "6.0.3",
		"unbuild": "^3.6.1",
		"vitest": "4.1.10",
		"vue": "^3.5.39",
		"vue-tsc": "^3.3.3"
	},
	"peerDependencies": {
		"nuxt": "^3.0.0 || ^4.0.0",
		"vue": "^3.5.39"
	},
	"peerDependenciesMeta": {
		"nuxt": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"nuxt": "./dist/module.mjs",
	"schema": "./schema/nuxt.schema.d.ts"
}
