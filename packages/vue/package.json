{
	"name": "@c15t/vue",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"import": "./dist/vite.mjs"
		},
		"./vue-plugin": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./consent-root": {
			"types": "./dist/runtime/components/consent-root.d.vue.ts",
			"import": "./dist/runtime/components/consent-root.vue"
		},
		"./runtime/*": "./dist/runtime/*",
		"./composables/*": "./dist/runtime/composables/*"
	},
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			],
			"vite": [
				"./dist/vite.d.mts"
			],
			"vue-plugin": [
				"./dist/index.d.mts"
			]
		}
	},
	"main": "./dist/module.mjs",
	"nuxt": "./dist/module.mjs",
	"schema": "./schema/nuxt.schema.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "nuxt-module-build build",
		"prepack": "bun run build",
		"dev": "nuxt dev playground",
		"dev:build": "nuxt build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
		"check-types": "bun run check-types:nuxt && bun run check-types:vue",
		"check-types:nuxt": "nuxt typecheck playground",
		"check-types:vue": "vue-tsc -p tsconfig.vue.json --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@c15t/config": "workspace:*",
		"@c15t/schema": "workspace:*",
		"@c15t/styles": "workspace:*",
		"@c15t/utils": "workspace:*",
		"@vueuse/core": "^14.3.0",
		"defu": "^6.1.4",
		"reka-ui": "^2.9.9",
		"ufo": "^1.6.1",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@nuxt/kit": "^4.4.7",
		"@nuxt/module-builder": "^1.0.2",
		"nuxt": "^4.4.7",
		"typescript": "5.9.3",
		"vitest": "4.0.15",
		"vue-tsc": "^3.3.3"
	},
	"peerDependencies": {
		"nuxt": "^3.0.0 || ^4.0.0"
	},
	"peerDependenciesMeta": {
		"nuxt": {
			"optional": true
		}
	}
}
