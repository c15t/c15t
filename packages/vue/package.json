{
	"name": "@c15t/vue",
	"version": "2.0.0-rc.4",
	"description": "Developer-first CMP for Vue and Nuxt: cookie banner, consent manager, preference center composables. GDPR ready with minimal setup and rich customization",
	"keywords": [
		"ccpa",
		"cmp",
		"consent",
		"consent-banner",
		"consent-management-platform",
		"cookie-banner",
		"gdpr",
		"headless",
		"lgpd",
		"nuxt",
		"privacy",
		"privacy-compliance",
		"typescript",
		"user-consent",
		"vue",
		"web-privacy"
	],
	"homepage": "https://c15t.com",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/vue"
	},
	"files": [
		"dist",
		"schema"
	],
	"type": "module",
	"main": "./dist/module.mjs",
	"types": "./dist/types.d.mts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			],
			"vite": [
				"./dist/vite.d.mts"
			],
			"vue-plugin": [
				"./dist/index.d.mts"
			],
			"devtools": [
				"./dist/devtools.d.mts"
			]
		}
	},
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs",
			"default": "./dist/module.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"import": "./dist/vite.mjs",
			"default": "./dist/vite.mjs"
		},
		"./vue-plugin": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		},
		"./devtools": {
			"types": "./dist/devtools.d.mts",
			"import": "./dist/devtools.mjs",
			"default": "./dist/devtools.mjs"
		},
		"./consent-root": {
			"types": "./dist/runtime/components/consent-root.d.vue.ts",
			"import": "./dist/runtime/components/consent-root.vue",
			"default": "./dist/runtime/components/consent-root.vue"
		},
		"./consent-widget": {
			"types": "./dist/runtime/components/consent-widget.d.vue.ts",
			"import": "./dist/runtime/components/consent-widget.vue",
			"default": "./dist/runtime/components/consent-widget.vue"
		},
		"./runtime/*": "./dist/runtime/*",
		"./composables/*": "./dist/runtime/composables/*"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "nuxt-module-build build",
		"check-types": "bun run check-types:nuxt && bun run check-types:vue",
		"check-types:nuxt": "nuxt typecheck playground",
		"check-types:vue": "vue-tsc -p tsconfig.vue.json --noEmit",
		"dev": "nuxt dev playground",
		"dev:build": "nuxt build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
		"prepack": "bun run build",
		"test": "vitest run"
	},
	"dependencies": {
		"@c15t/core": "workspace:*",
		"@c15t/dev-tools": "workspace:*",
		"@c15t/schema": "workspace:*",
		"@c15t/translations": "workspace:*",
		"@c15t/ui": "workspace:*",
		"@nuxt/kit": "^3.0.0 || ^4.0.0",
		"defu": "^6.1.4",
		"ufo": "^1.6.1"
	},
	"devDependencies": {
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@nuxt/module-builder": "^1.0.2",
		"@vitejs/plugin-vue": "6.0.7",
		"@vue/test-utils": "^2.4.6",
		"h3": "1.15.11",
		"jsdom": "^25.0.0",
		"nitropack": "2.13.4",
		"nuxt": "^4.5.1",
		"pathe": "^2.0.3",
		"typescript": "6.0.3",
		"unbuild": "^3.6.1",
		"vitest": "4.1.9",
		"vue": "^3.5.39",
		"vue-tsc": "^3.3.3"
	},
	"peerDependencies": {
		"nuxt": "^3.0.0 || ^4.0.0",
		"vue": "^3.5.39"
	},
	"peerDependenciesMeta": {
		"nuxt": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"nuxt": "./dist/module.mjs",
	"schema": "./schema/nuxt.schema.d.ts"
}
