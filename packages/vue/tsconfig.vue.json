{
	"extends": "@c15t/typescript-config/base.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"baseUrl": ".",
		"paths": {
			"#imports": ["./src/runtime/vue/stubs.ts"],
			"#c15t/composables": ["./src/runtime/composables/index.ts"],
			"@c15t/conformance": ["../../internals/conformance/src/index.ts"],
			"@c15t/translations": ["../translations/src/index.ts"],
			"@c15t/translations/all": ["../translations/src/all.ts"]
		}
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.vue",
		"src/**/*.d.ts",
		"src/env.d.ts",
		"src/c15t-aliases.d.ts"
	],
	"exclude": ["src/**/*.nuxt.ts", "src/runtime/plugin.nuxt.ts", "src/module.ts"]
}
