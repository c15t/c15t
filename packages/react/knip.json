{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"entry": [
		"./src/index.ts",
		"./src/provider.tsx",
		"./src/hooks.ts",
		"./src/draft.tsx",
		"./src/module-hooks.ts",
		"./src/module-hooks/script-loader.ts",
		"./src/module-hooks/persistence.ts",
		"./src/module-hooks/network-blocker.ts",
		"./src/module-hooks/iframe-blocker.ts",
		"./src/consent-banner.ts",
		"./src/consent-dialog.ts",
		"./src/consent-widget.ts",
		"./src/consent-dialog-link.ts",
		"./src/consent-dialog-trigger.ts",
		"./src/frame.ts",
		"./src/iab.ts",
		"./src/primitives.ts",
		"./src/primitives/*.ts",
		"./src/server/index.ts",
		"./src/headless.ts",
		"./src/components/consent-banner/index.ts",
		"./src/components/consent-dialog/index.ts",
		"./src/components/consent-dialog-trigger/index.ts",
		"./src/components/consent-dialog-link/index.ts",
		"./src/components/consent-widget/index.ts",
		"./src/components/frame/index.ts",
		"./src/context/index.ts",
		"./src/types/index.ts",
		"./src/utils/index.ts"
	],
	"ignoreBinaries": ["oxfmt", "oxlint", "rslib", "tsc", "vitest"],
	"ignore": [
		"**/*.spec.{js,ts,tsx}",
		"**/*.test.{js,ts,tsx}",
		"**/__tests__/**",
		"rslib.config.ts"
	],
	"ignoreDependencies": ["@c15t/typescript-config", "c15t"],
	"rules": {
		"exports": "warn",
		"types": "warn",
		"dependencies": "error",
		"files": "warn"
	},
	"ignoreExportsUsedInFile": true
}
