{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"entry": [
		"./src/index.ts",
		"./src/provider.tsx",
		"./src/hooks.ts",
		"./src/draft.tsx",
		"./src/module-hooks.ts",
		"./src/module-hooks/script-loader.ts",
		"./src/module-hooks/persistence.ts",
		"./src/module-hooks/network-blocker.ts",
		"./src/module-hooks/iframe-blocker.ts",
		"./src/prompt.ts",
		"./src/panel.ts",
		"./src/preferences.ts",
		"./src/panel-link.ts",
		"./src/panel-trigger.ts",
		"./src/consent-gate.ts",
		"./src/iab.ts",
		"./src/primitives.ts",
		"./src/primitives/*.ts",
		"./src/server/index.ts",
		"./src/headless.ts",
		"./src/components/prompt/index.ts",
		"./src/components/panel/index.ts",
		"./src/components/panel-trigger/index.ts",
		"./src/components/panel-link/index.ts",
		"./src/components/preferences/index.ts",
		"./src/components/consent-gate/index.ts",
		"./src/context/index.ts",
		"./src/types/index.ts",
		"./src/utils/index.ts",
		"./styles*.css",
		"./iab/styles*.css",
		"./src/styles*.css",
		"./src/iab/styles*.css"
	],
	"ignoreBinaries": ["oxfmt", "oxlint", "rslib", "tsc", "vitest"],
	"ignore": [
		"**/*.spec.{js,ts,tsx}",
		"**/*.test.{js,ts,tsx}",
		"**/__tests__/**",
		"rslib.config.ts"
	],
	"ignoreDependencies": ["@c15t/typescript-config", "c15t"],
	"rules": {
		"exports": "warn",
		"types": "warn",
		"dependencies": "error",
		"files": "warn"
	},
	"ignoreExportsUsedInFile": true
}
