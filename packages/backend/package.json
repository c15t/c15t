{
	"name": "@c15t/backend",
	"version": "2.2.0-canary-20260731105620",
	"description": "Self-hostable consent management backend for c15t with policy resolution, audit logs, geolocation, and Postgres, MySQL and SQLite storage.",
	"keywords": [
		"backend",
		"ccpa",
		"cmp",
		"compliance",
		"consent",
		"consent-backend",
		"consent-banner",
		"consent-management",
		"consent-management-platform",
		"cookie-banner",
		"data-protection",
		"gdpr",
		"lgpd",
		"privacy",
		"self-host",
		"self-hosted-cmp",
		"user-privacy"
	],
	"homepage": "https://c15t.com/docs/self-host/quickstart",
	"bugs": {
		"url": "https://github.com/c15t/c15t/issues"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/backend"
	},
	"files": [
		"dist",
		"dist-types",
		"AGENTS.md",
		"SKILL.md",
		"docs"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./sql/pg": {
			"types": "./dist-types/sql/pg.d.ts",
			"import": "./dist/sql/pg.js",
			"default": "./dist/sql/pg.js"
		},
		"./sql/mysql": {
			"types": "./dist-types/sql/mysql.d.ts",
			"import": "./dist/sql/mysql.js",
			"default": "./dist/sql/mysql.js"
		},
		"./sql/sqlite": {
			"types": "./dist-types/sql/sqlite.d.ts",
			"import": "./dist/sql/sqlite.js",
			"default": "./dist/sql/sqlite.js"
		},
		"./db/migrations/*": {
			"types": "./dist-types/db/migrations/*.d.ts",
			"import": "./dist/db/migrations/*.js",
			"default": "./dist/db/migrations/*.js"
		},
		"./cache": {
			"types": "./dist-types/cache/index.d.ts",
			"import": "./dist/cache/index.js",
			"default": "./dist/cache/index.js"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "rslib build && bun ../../scripts/normalize-dist-types.mjs && bun ../../scripts/generate-package-docs.ts @c15t/backend",
		"check-types": "tsc --noEmit",
		"dev": "sh -c 'rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun oxfmt .",
		"lint": "bun oxlint ./src",
		"prebuild": "genversion --esm --semi src/version.ts",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@c15t/schema": "workspace:*",
		"@c15t/translations": "workspace:*",
		"effect": "4.0.0-beta.102",
		"evlog": "2.22.4",
		"hono": "4.12.27",
		"hono-openapi": "1.3.0",
		"jose": "6.2.3",
		"valibot": "1.4.2"
	},
	"devDependencies": {
		"@c15t/backend-conformance": "workspace:*",
		"@c15t/migration-fixtures": "workspace:*",
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@effect/sql-mysql2": "4.0.0-beta.102",
		"@effect/sql-pg": "4.0.0-beta.102",
		"@effect/sql-pglite": "4.0.0-beta.102",
		"@effect/sql-sqlite-node": "4.0.0-beta.102",
		"@effect/vitest": "4.0.0-beta.102",
		"@types/node": "^24.10.1",
		"genversion": "3.2.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@effect/sql-mysql2": "4.0.0-beta.102",
		"@effect/sql-pg": "4.0.0-beta.102",
		"@effect/sql-sqlite-node": "4.0.0-beta.102",
		"@upstash/redis": "^1.38.0"
	},
	"peerDependenciesMeta": {
		"@effect/sql-mysql2": {
			"optional": true
		},
		"@effect/sql-pg": {
			"optional": true
		},
		"@effect/sql-sqlite-node": {
			"optional": true
		},
		"@upstash/redis": {
			"optional": true
		}
	}
}
