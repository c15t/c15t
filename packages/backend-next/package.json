{
	"name": "@c15t/backend-next",
	"version": "0.0.0",
	"private": true,
	"description": "Effect rewrite of @c15t/backend, developed in parallel until it reaches parity. Renamed to @c15t/backend at cutover — see internals/rfcs/0004-backend-effect-rewrite.md.",
	"repository": {
		"type": "git",
		"url": "https://github.com/c15t/c15t.git",
		"directory": "packages/backend-next"
	},
	"license": "Apache-2.0",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist-types/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./sql/pg": {
			"types": "./dist-types/sql/pg.d.ts",
			"import": "./dist/sql/pg.js",
			"require": "./dist/sql/pg.cjs"
		},
		"./sql/mysql": {
			"types": "./dist-types/sql/mysql.d.ts",
			"import": "./dist/sql/mysql.js",
			"require": "./dist/sql/mysql.cjs"
		},
		"./sql/sqlite": {
			"types": "./dist-types/sql/sqlite.d.ts",
			"import": "./dist/sql/sqlite.js",
			"require": "./dist/sql/sqlite.cjs"
		},
		"./db/migrations/*": {
			"types": "./dist-types/db/migrations/*.d.ts",
			"import": "./dist/db/migrations/*.js",
			"require": "./dist/db/migrations/*.cjs"
		},
		"./cache": {
			"types": "./dist-types/cache/index.d.ts",
			"import": "./dist/cache/index.js",
			"require": "./dist/cache/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist-types/index.d.ts",
	"files": [
		"dist",
		"dist-types"
	],
	"scripts": {
		"prebuild": "genversion --esm --semi src/version.ts",
		"build": "rslib build && bun ../../scripts/normalize-dist-types.mjs",
		"check-types": "tsc --noEmit",
		"dev": "sh -c 'rslib build --no-dts --no-clean && rslib build --watch --no-dts --no-clean'",
		"fmt": "bun biome format --write . && bun biome check --formatter-enabled=false --linter-enabled=false --write",
		"lint": "bun biome lint ./src",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@c15t/schema": "workspace:*",
		"effect": "4.0.0-beta.102",
		"evlog": "2.22.4",
		"hono": "4.12.27",
		"hono-openapi": "1.3.0",
		"jose": "6.2.3",
		"valibot": "1.4.2"
	},
	"devDependencies": {
		"@c15t/backend": "workspace:*",
		"@c15t/backend-conformance": "workspace:*",
		"@c15t/migration-fixtures": "workspace:*",
		"@c15t/typescript-config": "workspace:*",
		"@c15t/vitest-config": "workspace:*",
		"@effect/sql-mysql2": "4.0.0-beta.102",
		"@effect/sql-pg": "4.0.0-beta.102",
		"@effect/sql-pglite": "4.0.0-beta.102",
		"@effect/sql-sqlite-node": "4.0.0-beta.102",
		"@effect/vitest": "4.0.0-beta.102",
		"@types/node": "^24.10.1",
		"genversion": "3.2.0",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@effect/sql-mysql2": "4.0.0-beta.102",
		"@effect/sql-pg": "4.0.0-beta.102",
		"@effect/sql-sqlite-node": "4.0.0-beta.102",
		"@upstash/redis": "^1.38.0"
	},
	"peerDependenciesMeta": {
		"@effect/sql-mysql2": {
			"optional": true
		},
		"@effect/sql-pg": {
			"optional": true
		},
		"@effect/sql-sqlite-node": {
			"optional": true
		},
		"@upstash/redis": {
			"optional": true
		}
	}
}
