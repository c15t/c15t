{
	"$schema": "https://turborepo.dev/schema.v2.json",
	"concurrency": "20",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": [
				".next/**",
				"!.next/cache/**",
				".nuxt/**",
				".output/**",
				"dist/**",
				"dist-types/**",
				"storybook-static/**",
				"src/version.ts"
			],
			"env": ["WITH_RSDOCTOR"]
		},
		"c15t#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**"]
		},
		"@c15t/core#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"$TURBO_ROOT$/scripts/prune-dist-types.ts",
				"$TURBO_ROOT$/scripts/manifest-utils.ts",
				"$TURBO_ROOT$/packages/shared/rslib-modules.ts",
				"$TURBO_ROOT$/packages/shared/rslib-utils.ts",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**"
			],
			"outputs": ["dist/**", "dist-types/**", "src/version.ts"],
			"env": ["WITH_RSDOCTOR"]
		},
		"@c15t/schema#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"$TURBO_ROOT$/packages/shared/rslib-modules.ts",
				"$TURBO_ROOT$/packages/shared/rslib-utils.ts",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**"
			],
			"outputs": ["dist/**", "dist-types/**"],
			"env": ["WITH_RSDOCTOR"]
		},
		"@c15t/react#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**", "dist-types/**", "src/version.ts"],
			"env": ["WITH_RSDOCTOR"]
		},
		"@c15t/nextjs#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**", "dist-types/**", "src/version.ts"],
			"env": ["WITH_RSDOCTOR"]
		},
		"@c15t/tanstack-start#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**", "dist-types/**", "src/version.ts"],
			"env": ["WITH_RSDOCTOR"]
		},
		"@c15t/backend#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**", "dist-types/**", "src/version.ts"],
			"env": ["WITH_RSDOCTOR"]
		},
		"@c15t/example-nuxt#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json"
			],
			"outputs": [".nuxt/**", ".output/**", ".vercel/output/**"],
			"env": ["VERCEL", "NITRO_PRESET", "NUXT_PUBLIC_C15T_BACKEND_URL"]
		},
		"@c15t/example-tanstack-start#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json"
			],
			"outputs": ["dist/**"],
			"env": ["VERCEL", "VITE_C15T_BACKEND_URL"]
		},
		"@c15t/benchmarking#build": {
			"dependsOn": ["^build"],
			"outputs": [],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json"
			]
		},
		"@c15t/solid#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": []
		},
		"@c15t/svelte#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**", "src/lib/version.ts"]
		},
		"@c15t/vue#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**"]
		},
		"fmt": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxfmt.config.ts"],
			"outputs": []
		},
		"lint": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/oxlint.config.ts"],
			"dependsOn": ["transit"]
		},
		"check-types": {
			"dependsOn": ["build", "^build"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true
		},
		"@c15t/example-demo#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"dependsOn": ["c15t#build"],
			"with": [
				"@c15t/core#dev",
				"@c15t/backend#dev",
				"@c15t/iab#dev",
				"@c15t/logger#dev",
				"@c15t/nextjs#dev",
				"@c15t/react#dev",
				"@c15t/schema#dev",
				"@c15t/scripts#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"@c15t/example-nuxt#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"dependsOn": ["c15t#build"],
			"with": [
				"@c15t/core#dev",
				"@c15t/backend#dev",
				"@c15t/logger#dev",
				"@c15t/schema#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"@c15t/example-tanstack-start#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"dependsOn": ["c15t#build"],
			"with": [
				"@c15t/core#dev",
				"@c15t/backend#dev",
				"@c15t/logger#dev",
				"@c15t/react#dev",
				"@c15t/schema#dev",
				"@c15t/tanstack-start#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"astro-demo#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"dependsOn": ["c15t#build"],
			"with": [
				"@c15t/astro#dev",
				"@c15t/core#dev",
				"@c15t/iab#dev",
				"@c15t/logger#dev",
				"@c15t/schema#dev",
				"@c15t/svelte#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"sveltekit-demo#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"dependsOn": ["c15t#build"],
			"with": [
				"@c15t/core#dev",
				"@c15t/backend#dev",
				"@c15t/iab#dev",
				"@c15t/logger#dev",
				"@c15t/schema#dev",
				"@c15t/svelte#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"@c15t/nextjs-browser-bench#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"with": [
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/nextjs#dev",
				"@c15t/react#dev",
				"@c15t/schema#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"@c15t/tanstack-start-browser-bench#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"with": [
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/react#dev",
				"@c15t/schema#dev",
				"@c15t/tanstack-start#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"@c15t/astro-browser-bench#build": {
			"dependsOn": ["^build"],
			"env": [
				"C15T_BENCH_ASTRO_MODE",
				"C15T_BENCH_ORIGIN",
				"C15T_BENCH_OUT_DIR"
			],
			"outputs": [".astro/**", "dist/**", "dist-baseline/**", "dist-hosted/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json"
			]
		},
		"@c15t/astro-browser-bench#dev": {
			"cache": false,
			"interruptible": true,
			"persistent": true,
			"with": [
				"@c15t/astro#dev",
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/schema#dev",
				"@c15t/svelte#dev",
				"@c15t/translations#dev"
			]
		},
		"@c15t/nuxt-browser-bench#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"with": [
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/schema#dev",
				"@c15t/translations#dev",
				"@c15t/vue#dev"
			]
		},
		"@c15t/sveltekit-browser-bench#build": {
			"dependsOn": ["^build"],
			"outputs": [".svelte-kit/**", "build/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json"
			]
		},
		"@c15t/sveltekit-browser-bench#dev": {
			"cache": false,
			"interruptible": true,
			"persistent": true,
			"with": [
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/schema#dev",
				"@c15t/svelte#dev",
				"@c15t/translations#dev"
			]
		},
		"@c15t/css-layer-preview#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"with": [
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/nextjs#dev",
				"@c15t/react#dev",
				"@c15t/schema#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"@c15t/tw3-css-test#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"with": [
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/nextjs#dev",
				"@c15t/react#dev",
				"@c15t/schema#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"@c15t/tw4-css-test#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"with": [
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/nextjs#dev",
				"@c15t/react#dev",
				"@c15t/schema#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"@c15t/no-tw-css-test#dev": {
			"cache": false,
			"persistent": true,
			"interruptible": true,
			"with": [
				"@c15t/core#dev",
				"@c15t/logger#dev",
				"@c15t/nextjs#dev",
				"@c15t/react#dev",
				"@c15t/schema#dev",
				"@c15t/translations#dev",
				"@c15t/ui#dev"
			]
		},
		"storybook": {
			"cache": false,
			"persistent": true
		},
		"bundle-bench": {
			"dependsOn": ["^build"],
			"outputs": ["report/**", "dist/**"]
		},
		"test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": [
				"coverage/coverage-summary.json",
				"coverage/coverage-final.json",
				"coverage/html/**"
			],
			"env": ["C15T_TEST_PG_URL", "C15T_TEST_MYSQL_URL"]
		},
		"@c15t/next-compat-15-app#check-types": {
			"dependsOn": []
		},
		"@c15t/next-compat-15-pages#check-types": {
			"dependsOn": []
		},
		"@c15t/next-compat-16-app#check-types": {
			"dependsOn": []
		},
		"@c15t/next-compat-16-cache-components#check-types": {
			"dependsOn": []
		},
		"@c15t/next-compat-16-pages#check-types": {
			"dependsOn": []
		},
		"@c15t/next-compat-16-static-export#check-types": {
			"dependsOn": []
		},
		"test:compat": {
			"cache": false,
			"dependsOn": ["build", "^build"],
			"env": [
				"COMPAT_FORCE_BUILD",
				"COMPAT_SKIP_BUILD",
				"COMPAT_PRINT_SERVER_LOGS"
			],
			"outputs": []
		},
		"@c15t/next-compat-16-static-export#test:compat": {
			"cache": false,
			"dependsOn": ["^build"],
			"env": [
				"COMPAT_FORCE_BUILD",
				"COMPAT_SKIP_BUILD",
				"COMPAT_PRINT_SERVER_LOGS"
			],
			"outputs": []
		},
		"test-storybook": {
			"dependsOn": ["build", "^build"],
			"outputs": []
		},
		"test:parity": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": ["playwright-report/**", "test-results/**"],
			"env": [
				"REACT_STORYBOOK_URL",
				"SVELTE_STORYBOOK_URL",
				"VUE_STORYBOOK_URL",
				"SOLID_STORYBOOK_URL",
				"PARITY_FRAMEWORKS"
			]
		},
		"bench": {
			"dependsOn": ["build", "^build"],
			"cache": false,
			"outputs": [".benchmarks/**"]
		},
		"bench:ci": {
			"dependsOn": ["build", "^build"],
			"cache": false,
			"outputs": [".benchmarks/**"]
		},
		"bench:nightly": {
			"dependsOn": ["build", "^build"],
			"cache": false,
			"outputs": [".benchmarks/**"]
		},
		"c15t#test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": []
		},
		"@c15t/scripts#test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": [
				"coverage/coverage-summary.json",
				"coverage/coverage-final.json",
				"coverage/html/**"
			]
		},
		"transit": {
			"dependsOn": ["^transit"]
		},
		"@c15t/scripts#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**", "dist-types/**"],
			"env": ["WITH_RSDOCTOR"]
		},
		"@c15t/cli#build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				".env*",
				"!docs/**",
				"!AGENTS.md",
				"!SKILL.md",
				"!README.md",
				"!readme.json",
				"$TURBO_ROOT$/packages/shared/**",
				"$TURBO_ROOT$/scripts/normalize-dist-types.mjs"
			],
			"outputs": ["dist/**", "dist-types/**"],
			"env": ["WITH_RSDOCTOR"]
		},
		"build:docs": {
			"inputs": [
				"$TURBO_ROOT$/docs/**",
				"$TURBO_ROOT$/scripts/generate-package-docs.ts",
				"$TURBO_ROOT$/scripts/package-doc-entry-points.ts",
				"$TURBO_ROOT$/scripts/rewrite-package-doc-links.ts",
				"package.json"
			],
			"outputs": ["docs/**", "AGENTS.md", "SKILL.md"]
		},
		"check-types:test": {
			"dependsOn": ["build", "^build"]
		},
		"@c15t/next-bundle-bench#test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"@c15t/backend-bench#build": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"sveltekit-demo#build": {
			"dependsOn": ["^build"],
			"outputs": [".svelte-kit/**", "build/**"]
		},
		"@c15t/conformance#test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": []
		},
		"@c15t/parity-runner#test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": []
		},
		"@c15t/dev-tools#test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": []
		},
		"@c15t/solid#test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": []
		},
		"@c15t/benchmarking#test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": []
		},
		"@c15t/example-demo#test": {
			"dependsOn": ["build", "^build", "transit"],
			"outputs": []
		}
	}
}
