{
	"name": "@c15t/svelte-compat-5-20",
	"version": "0.0.0",
	"private": true,
	"description": "Compatibility fixture: the oldest Svelte and SvelteKit versions @c15t/svelte supports.",
	"type": "module",
	"scripts": {
		"build": "vite build",
		"check-types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"start": "node build"
	},
	"dependencies": {
		"@c15t/integrations": "workspace:*",
		"@c15t/svelte": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.63.0",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"svelte": "5.20.0",
		"svelte-check": "^4.7.6",
		"typescript": "6.0.3",
		"vite": "7.3.2"
	}
}
