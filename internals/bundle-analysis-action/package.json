{
	"name": "@c15t/bundle-analysis-action",
	"version": "0.1.0",
	"private": true,
	"description": "Analyze bundle size differences using rsdoctor and comment on PRs",
	"license": "Apache-2.0",
	"author": "c15t",
	"main": "dist/index.js",
	"scripts": {
		"build": "ncc build src/main.ts -o dist -m",
		"check-types": "tsc --noEmit",
		"fmt": "bun oxfmt .",
		"lint": "bun oxlint ./src",
		"test": "vitest run"
	},
	"dependencies": {
		"@actions/core": "^3.0.1",
		"@actions/github": "^9.1.1",
		"@actions/glob": "^0.7.0"
	},
	"devDependencies": {
		"@types/node": "^25.5.0",
		"@vercel/ncc": "^0.38.4",
		"tsx": "^4.23.0",
		"typescript": "6.0.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=18"
	}
}
