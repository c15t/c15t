{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"jsx": "react-jsx",
		"types": ["vite/client"],
		"allowJs": false
	},
	"include": ["src/**/*", "vite.config.ts"]
}
