{
	"name": "@c15t/next-compat-16-static-export",
	"version": "0.0.0",
	"private": true,
	"description": "Compatibility fixture: Next.js 16, App Router, output: export (static export).",
	"type": "module",
	"scripts": {
		"build": "bun ../shared/scripts/pack.ts && bun scripts/generate-manifest.ts && next build",
		"dev": "next dev",
		"fmt": "bun biome format --write . && bun biome check --formatter-enabled=false --linter-enabled=false --write",
		"lint": "bun biome lint .",
		"test:compat": "vitest run"
	},
	"dependencies": {
		"@c15t/next-compat-shared": "workspace:*",
		"@c15t/nextjs": "workspace:*",
		"next": "16.3.4",
		"react": "19.2.7",
		"react-dom": "19.2.7"
	},
	"devDependencies": {
		"@types/node": "25.5.0",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"playwright": "1.61.1",
		"typescript": "6.0.3",
		"vitest": "4.1.9"
	}
}
