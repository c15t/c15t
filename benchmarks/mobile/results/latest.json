			"note": "bootstrap() to first synchronous snapshot(), cold: under 15 ms."
		},
		"cold_start_overhead_ms": {
			"max": 10,
			"unit": "ms",
			"source": "contract",
			"note": "Cold-start overhead attributable to c15t: under 10 ms. Measured as the cold bootstrap-to-first-snapshot span, which is the only work c15t adds to launch before the first read."
		},
		"commit_ack_no_network_ms": {
			"max": 50,
			"unit": "ms",
			"source": "contract",
			"note": "Consent action to native commit acknowledged, no network: under 50 ms."
		},
		"rerenders_per_consent_change": {
			"max": 1,
			"unit": "count",
			"source": "contract",
			"note": "React rerenders per consent change: at most one per subscribed component."
		},
		"rerenders_per_unchanged_event": {
			"max": 0,
			"unit": "count",
			"source": "contract",
			"note": "Derived from the contract: the module never sends a snapshot JavaScript already holds, and selector subscriptions rerender only when the selected value changes, so an unchanged snapshot event must cost zero rerenders."
		},
		"snapshot_object_identities": {
			"max": 1,
			"unit": "count",
			"source": "contract",
			"note": "snapshot() and isAllowed() must not allocate a new snapshot per call. Counted as the number of distinct snapshot objects observed across repeated reads: one object means none was built per call."
		},
		"native_bootstrap_to_snapshot_warm_ms": {
			"max": 5,
			"unit": "ms",
			"source": "contract",
			"note": "bootstrap() to first synchronous snapshot(), warm, on the native core: under 5 ms."
		},
		"native_bootstrap_to_snapshot_cold_ms": {
			"max": 15,
			"unit": "ms",
			"source": "contract",
			"note": "bootstrap() to first synchronous snapshot(), cold, on the native core: under 15 ms."
		},
		"native_hydrate_envelope_ms": {
			"max": 3,
			"unit": "ms",
			"source": "contract",
			"note": "Native hydrate from a stored envelope: under 3 ms for a realistic payload."
		},
		"native_commit_ack_no_network_ms": {
			"max": 50,
			"unit": "ms",
			"source": "contract",
			"note": "Native consent action to commit acknowledged, no network: under 50 ms."
		},
		"native_snapshot_object_identities": {
			"max": 1,
			"unit": "count",
			"source": "contract",
			"note": "The native read must not build a snapshot per call, counted as distinct snapshot objects across repeated reads."
		},
		"native_snapshot_read_us": {
			"max": 2,
			"unit": "us",
			"source": "allowance",
			"note": "No contract number for the read itself. 2 us is the guard against a synchronous read that starts doing work."
		},
		"policy_evaluation_us": {
			"max": 50,
			"unit": "us",
			"source": "allowance",
			"note": "The contract sets no ceiling for evaluation alone; the native benches already assert this one. 50 us guards against a blow-up in the selector path without pretending to be a contract number."
		},
		"snapshot_read_us": {
			"max": 2,
			"unit": "us",
			"source": "allowance",
			"note": "No contract number; the contract forbids per-call allocation and I/O instead. 2 us is a guard for a synchronous read that starts touching something it should not."
		},
		"idle_cpu_percent": {
			"max": 2,
			"unit": "percent",
			"source": "allowance",
			"note": "Quiet window with one active subscription: no timer, no poll, no network. 2 % of one core allows the periodic reachability hook and rules out a busy loop."
		},
		"idle_rss_growth_bytes": {
			"max": 262144,
			"unit": "bytes",
			"source": "allowance",
			"note": "Resident-set growth across the quiet window: 256 KiB allows the allocator's own slack and rejects a per-tick leak."
		},
		"js_shipped_bytes": {
			"max": 98304,
			"unit": "bytes",
			"source": "allowance",
			"note": "Unpacked JavaScript in the @c15t/react-native tarball. 96 KiB is a ceiling for the boundary layer, which holds no kernel, no translations, and no policy engine."
		},
		"js_shipped_gzip_bytes": {
			"max": 24576,
			"unit": "bytes",
			"source": "allowance",
			"note": "Gzipped JavaScript the tarball ships. 24 KiB is the ceiling for a boundary layer: no kernel, no translations, no policy engine, no UI components in the public entry."
		},
		"ios_binary_bytes": {
			"max": 1048576,
			"unit": "bytes",
			"source": "allowance",
			"note": "Bytes C15tCore adds to an iOS binary, measured as the linked __TEXT plus __DATA of the arm64 slice. 1 MiB is the ceiling for the Swift core with no IAB."
		},
		"ios_binding_bytes": {
			"max": 262144,
			"unit": "bytes",
			"source": "allowance",
			"note": "TurboModule binding bytes on iOS. 256 KiB is the ceiling for a Codegen spec, a JSON marshalling layer, and an event emitter, with no consent logic in it."
		},
		"android_binary_bytes": {
			"max": 1048576,
			"unit": "bytes",
			"source": "allowance",
			"note": "Bytes the Kotlin core plus the bridge add to an Android app, measured as the uncompressed class bytes of the release artifacts. 1 MiB matches the iOS ceiling for the same engine."
		},
		"js_hydrate_envelope_ms": {
			"max": 3,
			"unit": "ms",
			"source": "contract",
			"note": "The contract's 3 ms hydrate budget, applied to the JavaScript decode of the stored envelope."
		},
		"jsx_global_reference_files": {
			"max": 0,
			"unit": "count",
			"source": "allowance",
			"note": "Built files that call `React.createElement` without importing React. Zero, because nothing defines a React global in a React Native app and the first render throws."
		},
		"package_manifest_parse_errors": {
			"max": 0,
			"unit": "count",
			"source": "allowance",
			"note": "Whether `packages/react-native/package.json` parses. Zero, because a manifest that is not valid JSON cannot be resolved by any Node consumer."
		},
		"native_is_allowed_us": {
			"max": 2,
			"unit": "us",
			"source": "allowance",
			"note": "No contract number for the read itself. Same 2 us guard as the snapshot read: the contract's requirement here is that neither read touches I/O."
		},
		"policy_apply_per_rule_set_us": {
			"max": 100,
			"unit": "us",
			"source": "allowance",
			"note": "Applying one rule set through the reference evaluator: build the kernel, feed it the fixture's /init body, read the snapshot back. The contract sets no number for this span and it is a wider one than the native `policy_evaluation_us` rows, which evaluate in isolation. 100 us is the regression guard the first measured run supported: 17-24 us across eight rule sets, so this trips on a 4x blow-up rather than on sampling noise."
		}
	},
