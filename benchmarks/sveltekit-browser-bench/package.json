{
	"name": "@c15t/sveltekit-browser-bench",
	"private": true,
	"type": "module",
	"scripts": {
		"bench": "BENCH_OUTPUT_DIR=../../.benchmarks/current/browser-runtime/sveltekit bunx tsx scripts/run-bench.ts",
		"bench:bundle": "bun run build && bunx tsx scripts/analyze-bundle.ts",
		"bench:ci": "BENCH_OUTPUT_DIR=../../.benchmarks/head/browser-runtime/sveltekit bunx tsx scripts/run-bench.ts",
		"bench:nightly": "BENCH_OUTPUT_DIR=../../.benchmarks/nightly/browser-runtime/sveltekit bunx tsx scripts/run-bench.ts",
		"build": "vite build",
		"check-types": "svelte-check --tsconfig ./tsconfig.json",
		"dev": "vite dev",
		"start": "node build/index.js"
	},
	"dependencies": {
		"@c15t/benchmarking": "workspace:*",
		"@c15t/core": "workspace:*",
		"@c15t/schema": "workspace:*",
		"@c15t/svelte": "workspace:*",
		"@c15t/translations": "workspace:*"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"playwright": "1.58.2",
		"svelte": "^5.0.0",
		"svelte-check": "^4.1.5",
		"typescript": "6.0.3",
		"vite": "^6.0.0"
	}
}
